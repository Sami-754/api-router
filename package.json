{
  "name": "api-router",
  "version": "0.1.0",
  "description": "Self-hosted, quota-aware API router across providers, accounts, credentials and capabilities",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "dev:web": "vite web",
    "mcp": "tsx src/server/mcp.ts",
    "web:build": "vite build web",
    "build": "pnpm web:build && pnpm build:server",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests web/src",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\" \"web/*.{ts,html}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\" \"web/*.{ts,html}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^18.0.3",
    "fastify": "^5.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.1.0",
    "vitest": "^3.0.4"
  }
}
