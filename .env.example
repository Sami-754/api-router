# API Router — local runtime
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/router.db

# 32+ byte secret used to encrypt upstream credentials at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
MASTER_KEY=change-me-to-a-long-random-secret-min-32-chars!!

# Default routing policy: auto | burn | preserve | fast | reliable | cheap | priority
DEFAULT_POLICY=auto
LOG_LEVEL=info

# Background credential validation: every N hours, probe up to VALIDATE_BATCH
# stale keys (0 = off). Probes are staggered; invalid keys are marked invalid.
VALIDATE_INTERVAL_H=0
VALIDATE_BATCH=25
